# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
next-env.d.ts

# production data — never committed
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# secrets
.env
.env.local
.env.production

# agent transcripts
.agent-logs/

# end-to-end runs
.e2e/
playwright-report/
test-results/
/playwright/.cache/

# terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
# .terraform.lock.hcl is deliberately NOT ignored: it pins the exact provider
# versions, so CI and a laptop resolve the same ones. Without it a provider
# release breaks an apply with no change on our side.
*.tfvars

# tooling
.DS_Store
*.tsbuildinfo
coverage/
.vscode/
.idea/
*.tfvars.json

# user seed data
user-seed.txt
# generated PIN hashes — set as the SEED_PIN_HASHES secret, never commit
.secrets/

# conversation memory, local to each gateway
data/hermes/

# Terraform override files: local scaffolding for a plan against a local
# backend. One of these on main would force that backend and break every
# deploy — and `git add -A` picked one up once.
*_override.tf
*_override.tf.json
