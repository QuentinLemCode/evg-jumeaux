{
  "name": "evg-jumeaux",
  "version": "0.1.0",
  "private": true,
  "description": "Leaderboard and match tracker for the EVG weekend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/reset.ts",
    "hash-pin": "tsx scripts/hash-pin.ts",
    "generate-users": "tsx scripts/generate-users.ts",
    "vapid:generate": "tsx scripts/vapid-generate.ts",
    "sweep": "tsx scripts/sweep.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:migrations": "node scripts/check-migrations.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint:e2e-coverage": "node scripts/check-e2e-coverage.mjs",
    "hermes:gateway": "tsx src/hermes/gateway.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
