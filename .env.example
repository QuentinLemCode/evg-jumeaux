# Copy to .env and fill in. Never commit .env.
#
# On the VM this file is written by Terraform at boot and rewritten by
# scripts/agent/deploy.sh on every release (IMAGE_TAG, GIT_COMMIT and the
# active colour). Locally you only need AUTH_SECRET.

# --- required ---------------------------------------------------------------
# Signs the session cookie, at least 32 characters. The app refuses to boot
# without it rather than run half-configured.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Where the SQLite file lives. On the VM this is inside the mounted volume.
DATABASE_PATH=./data/evg.db

# --- production --------------------------------------------------------------
# The FQDN Cloudflare serves, used for the health URL and the deploy check.
SITE_DOMAIN=evg.example.com
HEALTH_URL=https://evg.example.com/api/health

# --- web push (spec 0006) ---------------------------------------------------
# Generate once per environment with: npm run vapid:generate
# Regenerating them invalidates every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- production only: which image the stack runs ----------------------------
# Built by CI and pulled from GHCR; nothing is built on the VM.
# IMAGE_REPOSITORY=ghcr.io/you/evg-jumeaux
# IMAGE_TAG=sha-a1b2c3d
# GIT_COMMIT=a1b2c3d…            # reported by /api/health to prove a restart

# --- production only: compose wiring, set by Terraform ----------------------
# Tunnel ingress (default): no inbound port, Cloudflare terminates TLS.
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_PROFILES=tunnel,blue   # rewritten by deploy.sh on each release
# CADDY_SITE_ADDRESS=:8080
#
# Public-IP ingress (fallback): Caddy answers Cloudflare directly and gets its
# own certificate.
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# COMPOSE_PROFILES=public,blue
# CADDY_SITE_ADDRESS=evg.example.com

# Deploy-only values live in deploy.env, never here: they must not reach the
# app containers (GHCR_TOKEN, DISCORD_WEBHOOK_URL, TELEGRAM_BOT_TOKEN,
# TELEGRAM_CHAT_ID). The tunnel token lives alone in cloudflared.env.
